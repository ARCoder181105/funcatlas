{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"],
      // Vite substitutes DEV at build time. Declared so a production build is
      // not cached as if it were a development one.
      "env": ["DEV", "VITE_API_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // The parse worker. Without it a registered repository sits at "queued"
    // forever, which looks like a hung UI rather than a missing process.
    "worker": {
      "cache": false,
      "persistent": true
    }
  }
}
