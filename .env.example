# Local development environment for funcatlas.
# Copy to .env and fill in values. .env is gitignored; this file is committed.

# --- App (Fastify API) ---
NODE_ENV=development
PORT=3000
# Where a finished login lands the browser -- the WEB app, not this API. Named
# APP_PUBLIC_URL until Phase 3b, which was ambiguous with two apps in the repo
# and had it pointing at port 3000, so signing in dropped the user on a JSON
# endpoint instead of the canvas.
WEB_APP_URL=http://localhost:5173
# Allowed origin for the Vite dev server; tighten in production.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# --- Web (Vite) ---
# API endpoint the browser app calls.
VITE_API_URL=http://localhost:3000

# --- Postgres ---
# Shared by golang-migrate (parser) and the API (Drizzle/postgres.js).
DATABASE_URL=postgres://funcatlas:funcatlas@localhost:5432/funcatlas?sslmode=disable

# Where the integration tests run. Set this, or they fall back to DATABASE_URL
# and TRUNCATE the database you develop against -- every `make test` silently
# deletes the repositories you charted. Create it once with:
#   docker compose exec postgres psql -U funcatlas -d postgres \
#     -c "CREATE DATABASE funcatlas_test OWNER funcatlas;"
# then apply migrations to it the same way as DATABASE_URL.
TEST_DATABASE_URL=postgres://funcatlas:funcatlas@localhost:5432/funcatlas_test?sslmode=disable

# --- Redis ---
# Sessions (arctic/oslo) and the BullMQ parse queue.
REDIS_URL=redis://localhost:6379
# Queue name must match between API (producer) and parser (consumer).
QUEUE_NAME=funcatlas-parse

# --- Running without a GitHub OAuth app ---
# Set this to any name and the API registers no /auth/login, /auth/callback or
# /auth/logout, and treats every request as that user. `make setup` writes it
# for you, which is what makes `docker compose up` work from a fresh clone.
#
# It means the instance has NO AUTHENTICATION. Compose publishes on 127.0.0.1
# so nothing off-box can reach it; do not expose the port. Blank means off.
# See docs/RISKS.md R39.
FUNCATLAS_SINGLE_USER=

# --- GitHub OAuth ---
# Only needed when FUNCATLAS_SINGLE_USER is blank. Register an OAuth app and
# set its callback to GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=<client-id>
GITHUB_CLIENT_SECRET=<client-secret>
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Webhooks ---
# HMAC secret for verifying GitHub webhook payloads.
GITHUB_WEBHOOK_SECRET=<webhook-secret>

# --- Sessions ---
SESSION_SECRET=<random-32-byte-string>
SESSION_COOKIE_NAME=funcatlas_session
SESSION_TTL=604800

# --- Parser (Go) ---
# Input-hardening limits (see docs/SECURITY.md). Tune per runner.
# Binary the API spawns to register a repository; build it with
# `make go-build-bin`. Defaults to services/parser/bin/parser under the repo
# root, so it only needs setting if you put it elsewhere.
# PARSER_BIN=
# How long a registration may run before the parser is killed. Registration
# is synchronous in Phase 3a, so this is also the request's ceiling.
PARSE_TIMEOUT_MS=300000

PARSER_LOG_LEVEL=info
PARSER_MAX_FILE_BYTES=1048576
PARSER_MAX_FILES=50000
PARSER_MAX_DEPTH=25
PARSER_SKIP_PATHS=node_modules,.git,dist,build,coverage,.next